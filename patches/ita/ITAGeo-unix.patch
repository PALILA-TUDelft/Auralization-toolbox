+++ b/external_libs/CMakeLists.txt
@@ -106,7 +106,10 @@ CPMAddPackage (
 
 set_property (TARGET assimp PROPERTY FOLDER "external_libs")
 set_property (TARGET unit PROPERTY FOLDER "external_libs")
