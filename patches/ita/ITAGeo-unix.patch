diff --git a/CMakeLists.txt b/CMakeLists.txt
index fc7e701..bb1811a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -28,10 +28,15 @@ endif ()
 # ---External libs---
 add_subdirectory (external_libs)
 
-file (DOWNLOAD https://raw.githubusercontent.com/SketchUp/sketchup-live-c-api/main/cmake/FindSketchUpAPI.cmake
-	  ${CMAKE_BINARY_DIR}/cmake/FindSketchUpAPI.cmake
-)
-list (INSERT CMAKE_MODULE_PATH 0 ${CMAKE_BINARY_DIR}/cmake)
+# SketchUp is only used on Windows. Its Find module stops with an error on any other
+# system, so it is only fetched there; elsewhere find_package (SketchUpAPI) below
+# simply finds nothing.
+if (WIN32)
+	file (DOWNLOAD https://raw.githubusercontent.com/SketchUp/sketchup-live-c-api/main/cmake/FindSketchUpAPI.cmake
+		  ${CMAKE_BINARY_DIR}/cmake/FindSketchUpAPI.cmake
+	)
+	list (INSERT CMAKE_MODULE_PATH 0 ${CMAKE_BINARY_DIR}/cmake)
+endif ()
 
 if (DEFINED ENV{SketchUpAPI_DIR})
 	set (SketchUpAPI_DIR $ENV{SketchUpAPI_DIR})
diff --git a/external_libs/CMakeLists.txt b/external_libs/CMakeLists.txt
